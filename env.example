# Copia este archivo a .env y completa tus valores

# OpenAI (opcional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Discogs (opcional pero recomendado para mejores resultados)
DISCOGS_TOKEN=

# Rutas (ajusta a tu usuario)
DL_MUSIC_SCRIPT=/Users/matteoquintero/malapatacomecandela_system/dl-music-system.sh
LIB_BASE_DIR=/Users/matteoquintero/Music/mala_pata_come_candela
# Manifest por defecto dentro del proyecto (carpeta cache)
MANIFEST_FILE=/Users/matteoquintero/malapatacomecandela_system/cache/manifest.csv

# Cachés de YouTube (por defecto dentro del proyecto)
CHANNEL_CACHE_FILE=/Users/matteoquintero/malapatacomecandela_system/cache/yt_channel_cache.json
CHANNEL_CACHE_TTL_DAYS=30
SEARCH_CACHE_FILE=/Users/matteoquintero/malapatacomecandela_system/cache/yt_search_cache.json
SEARCH_CACHE_TTL_DAYS=45
MIN_SUBS_FOR_GENERIC_CHANNEL=30000

# Búsqueda sin API (yt-dlp)
SEARCH_MODE=no_api_first
NOAPI_SOURCES=ytsearch,ytmusicsearch,scsearch
YTDLP_BIN=yt-dlp
# Deshabilitar fallback a API completamente (evita gastar cuota)
DISABLE_API_FALLBACK=false

# YouTube API (opcional; si no se define, funciona en modo sin API)
YOUTUBE_API_KEY=
YOUTUBE_MAX_RESULTS=5
YOUTUBE_CALL_BUDGET=4000000

# Clasificador
CLASSIFIER_MODE=LLM_FALLBACK
PASS_HEURISTIC_TO_LLM=false

# Referencia de géneros para el LLM (opcional)
GENRE_REF_PATH=/Users/matteoquintero/malapatacomecandela_system/cache/genres_ref.json

# Spotify (para spotify_to_csv.py)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=https://localhost:8080/callback
# Caché de token Spotify (por defecto dentro del proyecto)
SPOTIFY_TOKEN_CACHE=/Users/matteoquintero/malapatacomecandela_system/cache/spotify_token_cache

# Debug (opcional)
# Establecer a "true" para mostrar mensajes de debug [DBG]
DEBUG_MODE=false
