# Copia este archivo a .env y completa tus valores

# OpenAI (opcional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Discogs (opcional pero recomendado para mejores resultados)
DISCOGS_TOKEN=

# Rutas (ajusta a tu usuario)
DL_MUSIC_SCRIPT=/Users/matteoquintero/malapatacomecandela_system/scripts/dl-music-system.sh
LIB_BASE_DIR=/Users/matteoquintero/Music/mala_pata_come_candela
# SQLite DB (fuente de verdad de la biblioteca)
LIBRARY_DB=/Users/matteoquintero/malapatacomecandela_system/cache/library.db

# Búsqueda (yt-dlp)
NOAPI_SOURCES=ytsearch,scsearch
YTDLP_BIN=yt-dlp

# Clasificador
CLASSIFIER_MODE=LLM_FALLBACK
PASS_HEURISTIC_TO_LLM=false

# Enrichment: consulta MusicBrainz/Discogs antes del clasificador.
# No bloqueante: si falla, el pipeline sigue. Cada intento queda en el log.
ENRICHMENT_ENABLED=true

# Log estructurado de clasificaciones (JSONL, una fila por track).
# Default: cache/classifier_log.jsonl
# CLASSIFIER_LOG_PATH=

# Referencia de géneros para el LLM (opcional)
GENRE_REF_PATH=/Users/matteoquintero/malapatacomecandela_system/cache/genres_ref.json

# Spotify (para spotify_to_csv.py y fallback de género)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=https://localhost:8080/callback
# Caché de token Spotify (por defecto dentro del proyecto)
SPOTIFY_TOKEN_CACHE=/Users/matteoquintero/malapatacomecandela_system/cache/spotify_token_cache

# Last.fm (opcional - fallback de búsqueda por género; gratis en https://www.last.fm/api)
LASTFM_API_KEY=

# Debug (opcional)
# Establecer a "true" para mostrar mensajes de debug [DBG]
DEBUG_MODE=false
